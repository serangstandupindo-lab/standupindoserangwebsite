# Supabase project settings for this city/community
# Use the publishable/anon key only. Never put service_role here.
# Copy this file to .env and replace with values from your own Supabase project.
# Only public values belong here. Never put a service_role key in this file.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_VAPID_PUBLIC_KEY=